<% html_title @deal.name %>
<%= render :partial => 'crm/shared/nav' %>

<div class="contextual">
  <% if [:admin, :staff].include?(crm_capability) %>
    <%= link_to sprite_icon('edit', l(:button_edit)), crm_edit_deal_path(@deal), :class => 'icon icon-edit' %>
    <%= link_to sprite_icon('list', l(:button_crm_list_deals)), crm_deals_path, :class => 'icon icon-list' %>
    <% if @deal.archived? %>
      <%= form_tag crm_restore_deal_path(@deal), :method => :put, :class => 'inline-form' do %>
        <%= hidden_field_tag :lock_version, @deal.lock_version %>
        <%= submit_tag l(:button_crm_restore) %>
      <% end %>
    <% else %>
      <%= form_tag crm_archive_deal_path(@deal), :method => :put, :class => 'inline-form' do %>
        <%= hidden_field_tag :lock_version, @deal.lock_version %>
        <%= submit_tag l(:button_crm_archive) %>
      <% end %>
    <% end %>
    <%= link_to l(:button_crm_add_activity), '#history', :class => 'icon icon-comment' %>
  <% end %>
</div>

<h2 class="inline-block"><%= h(@deal.name) %></h2>
<% if @deal.stage %>
  <% deal_badge_status = @deal.stage_kind.to_s == 'open' ? 'open' : 'closed' %>
  <span class="badge badge-status-<%= deal_badge_status %>"><%= h(@deal.stage.name) %></span>
<% end %>
<% if @deal.archived? %><span class="badge badge-status-archived"><%= l(:text_crm_record_archived) %></span><% end %>
<%= error_messages_for @deal if @deal.respond_to?(:errors) && @deal.errors.any? %>

<div class="issue details">
  <div class="attributes">
    <%= crm_fields_rows do |rows|
      rows.left l(:field_crm_account), (@deal.account ? crm_record_link(@deal.account) : '-'), :class => 'account'
      rows.left l(:field_crm_contact), (@deal.contact ? crm_record_link(@deal.contact) : '-'), :class => 'contact'
      rows.left l(:field_crm_pipeline), h(@deal.pipeline && @deal.pipeline.name), :class => 'pipeline'
      rows.left l(:field_crm_stage), h(@deal.stage && @deal.stage.name), :class => 'stage'
      rows.right l(:field_crm_owner), (@deal.owner_id.present? ? h(crm_owner_name(@deal.owner_id)) : '-'), :class => 'owner'
      rows.right l(:field_crm_probability), (@deal.probability.present? ? "#{@deal.probability}%" : '-'), :class => 'probability'
      rows.right l(:field_crm_expected_close_on), (@deal.expected_close_on ? format_date(@deal.expected_close_on) : '-'), :class => 'expected-close-on'
      rows.right l(:field_crm_next_action), h(@deal.next_action.presence || '-'), :class => 'next-action'
      rows.right l(:field_crm_next_action_on), (@deal.next_action_on ? format_date(@deal.next_action_on) : '-'), :class => 'next-action-on'
      if crm_money?
        rows.left l(:field_crm_amount), (@deal.amount_cents.present? ? crm_money(@deal.amount_cents, @deal.currency) : '-'), :class => 'amount'
      end
    end %>
    <%= render_half_width_custom_fields_rows(@deal) %>
  </div>
</div>
<% if [:admin, :staff].include?(crm_capability) %>
  <div id="crm-stage" class="crm-stage-form">
    <%= form_for @deal, :as => :deal, :url => crm_move_deal_path(@deal), :html => {:method => :put, :class => 'inline-form'} do |f| %>
      <%= f.label :stage_id, l(:field_crm_stage) %>
      <%= f.collection_select :stage_id, @deal.pipeline.stages.order(:position, :id), :id, :name, {}, :required => true %>
      <%= f.hidden_field :lock_version, :value => @deal.lock_version %>
      <%= f.submit l(:button_crm_save) %>
    <% end %>
  </div>
<% end %>

<% if @deal.description.present? %>
  <div class="description">
    <p><strong><%= l(:field_crm_description) %></strong></p>
    <div class="wiki"><%= textilizable @deal, :description, :attachments => ([:admin, :staff, :viewer].include?(crm_capability) ? @deal.attachments : []) %></div>
  </div>
<% end %>
<%= render_full_width_custom_fields_rows(@deal) %>


<% links = @deal.links.includes(:issue).to_a %>
<% issues = if [:admin, :staff].include?(crm_capability) && defined?(Issue)
              Issue.visible(User.current).order(:id => :desc).limit(200)
            else
              []
            end %>
<%= render :partial => 'crm/links/form', :locals => {:record => @deal, :links => links, :issues => issues} %>

<% if @deal.account %>
  <% account_projects = @deal.account.account_projects.includes(:project).to_a %>
  <section id="crm-projects" class="crm-related">
    <h3><%= l(:label_crm_projects) %></h3>
    <% if account_projects.any? %><table class="list odd-even"><thead><tr><th><%= l(:field_crm_project) %></th><th><%= l(:field_identifier) %></th></tr></thead><tbody>
      <% account_projects.each do |account_project| %><% project = account_project.project %><% next unless project %><tr><td><%= link_to h(project.name), project_path(project) %></td><td><%= h(project.identifier) %></td></tr><% end %>
    </tbody></table><% else %><p class="nodata"><%= l(:text_crm_no_linked_projects) %></p><% end %>
  </section>
<% end %>

<% if [:admin, :staff, :viewer].include?(crm_capability) %>
  <section id="crm-files" class="crm-related">
    <h3><%= l(:label_crm_files) %></h3>
    <% if @deal.attachments.any? %><%= link_to_attachments @deal, :thumbnails => true %><% else %><p class="nodata"><%= l(:text_crm_no_attachments) %></p><% end %>
  </section>
<% end %>

<%= render :partial => 'crm/shared/timeline', :locals => {:record => @deal, :timeline => @timeline, :composer => true} %>
