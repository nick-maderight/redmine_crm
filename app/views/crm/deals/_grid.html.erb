<% editable = %w[name owner owner_id stage stage_id amount_cents amount currency expected_close_on next_action next_action_on] %>
<% rows = @records.to_a.map do |record|
     values = record.respond_to?(:attributes) ? record.attributes : {:id => record.id, :lock_version => record.lock_version}
     if values['owner_id']
       values['owner'] = crm_owner_name(values['owner_id'])
       values.delete('owner_id')
     end
     crm_money? ? values : values.except('amount_cents', 'currency')
   end %>
<% columns = if @query && @query.respond_to?(:available_columns)
               @query.available_columns.map { |column| {:field => column.name.to_s, :title => column.caption.to_s, :editable => editable.include?(column.name.to_s)} }
             else
               base = [
                 {:field => 'name', :title => l(:field_crm_name), :editable => true},
                 {:field => 'stage', :title => l(:field_crm_stage), :editable => true},
                 {:field => 'owner', :title => l(:field_crm_owner), :editable => true},
                 {:field => 'expected_close_on', :title => l(:field_crm_expected_close_on), :editable => true},
                 {:field => 'next_action', :title => l(:field_crm_next_action), :editable => true},
                 {:field => 'next_action_on', :title => l(:field_crm_next_action_on), :editable => true}
               ]
               if crm_money?
                 base.insert(2, {:field => 'amount_cents', :title => l(:field_crm_amount), :editable => true})
                 base.insert(3, {:field => 'currency', :title => l(:field_crm_currency), :editable => true})
               end
               base
             end %>
<div id="crm-deals-grid" class="crm-grid" data-crm-rows="<%= h(ERB::Util.json_escape(rows.to_json)) %>" data-crm-update-url="<%= crm_deal_path(':id') %>" data-crm-columns="<%= h(ERB::Util.json_escape(columns.to_json)) %>" data-crm-record-type="deal">
  <noscript><p class="nodata"><%= l(:text_crm_enable_javascript_for_grid) %></p></noscript>
</div>
