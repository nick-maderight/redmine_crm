<%= render :partial => 'crm/shared/nav' %>
<% html_title l(:label_crm_deals_board) %>

<div class="crm crm-deals-board-page">
  <div class="contextual">
    <%= link_to sprite_icon('list', l(:button_crm_list_deals)), crm_deals_path, :class => 'icon icon-list' %>
  </div>

  <h2><%= l(:label_crm_deals_board) %><% if @pipeline %> <span class="subtitle"><%= h(@pipeline.name) %></span><% end %></h2>

  <div id="crm-deals-board" class="crm-board" data-crm-board="true" data-crm-move-url="<%= crm_move_deal_path(':id') %>">
    <% @stages.to_a.each do |stage| %>
      <% stage_deals = (@deals_by_stage || {})[stage.id] || [] %>
      <% stage_totals = (@totals_by_stage || {})[stage.id] || {} %>
      <div class="box crm-board-column crm-board-column-<%= h(stage.kind) %>" data-crm-stage-id="<%= stage.id %>">
        <h3>
          <%= h(stage.name) %>
          <span class="badge badge-count"><%= stage_deals.size %></span>
          <% if crm_money? && stage_totals.present? %>
            <span class="crm-board-column-total">
              <% stage_totals.each do |currency, cents| %><%= crm_money(cents, currency) %><% end %>
            </span>
          <% end %>
        </h3>

        <% closed = %w[won lost].include?(stage.kind.to_s) %>
        <div class="crm-board-cards<%= ' crm-board-cards-closed' if closed %>" data-crm-column="true" data-crm-stage-id="<%= stage.id %>">
          <% if closed %>
            <p class="nodata"><%= link_to l(:label_crm_board_closed_deals, :count => stage_deals.size), crm_deals_path(:set_filter => 1, :f => ['stage_id'], :op => {'stage_id' => '='}, :v => {'stage_id' => [stage.id.to_s]}) %></p>
          <% elsif stage_deals.any? %>
            <% stage_deals.each do |deal| %>
              <article class="crm-card crm-deal-card" data-crm-card="true" data-crm-id="<%= deal.id %>" data-deal-id="<%= deal.id %>" data-crm-lock-version="<%= deal.lock_version %>">
                <h4><%= crm_record_link(deal) %></h4>
                <% if deal.account %><p class="account"><%= crm_record_link(deal.account) %></p><% end %>
                <% if deal.next_action.present? %><p class="next-action"><%= h(crm_humanize_enum(deal.next_action)) %></p><% end %>
                <% if deal.next_action_on.present? %><time datetime="<%= deal.next_action_on.iso8601 %>"><%= format_date(deal.next_action_on) %></time><% end %>
              </article>
            <% end %>
          <% else %>
            <p class="nodata"><%= l(:text_crm_no_deals_in_stage) %></p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% content_for :header_tags do %>
  <%= javascript_include_tag 'sortable', 'crm', :plugin => 'redmine_crm' %>
<% end %>
