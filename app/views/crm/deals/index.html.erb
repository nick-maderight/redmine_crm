<% html_title(@query && @query.persisted? ? @query.name : l(:label_crm_deals)) %>
<div class="contextual">
  <% if [:admin, :staff].include?(crm_capability) %><%= link_to l(:button_crm_new_deal), crm_new_deal_path, :class => 'icon icon-add' %><% end %>
  <% if [:admin, :staff].include?(crm_capability) %><%= link_to l(:button_crm_open_board), crm_deals_board_path, :class => 'icon icon-stats' %><% end %>
</div>
<h2><%= @query && @query.persisted? ? h(@query.name) : l(:label_crm_deals) %></h2>
<% if @query %><%= form_tag crm_deals_path, :method => :get, :id => 'query_form' do %><%= render :partial => 'queries/query_form' %><% end %><% end %>
<% if @record_count.to_i.zero? %><p class="nodata"><%= l(:text_crm_no_deals) %></p><% end %>
<%= render :partial => 'grid' %>
<% content_for :sidebar do %><% if [:admin, :staff, :viewer].include?(crm_capability) && defined?(CrmDealQuery) %><%= render_sidebar_queries(CrmDealQuery, nil) %><% end %><% end %>
<% content_for :header_tags do %><%= javascript_include_tag 'tabulator', 'sortable', 'crm', :plugin => 'redmine_crm' %><% end %>
