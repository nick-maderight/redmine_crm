<% title = @query && @query.persisted? ? @query.name : l(:label_crm_deals) %>
<% html_title title %>
<div class="contextual">
  <% if [:admin, :staff].include?(crm_capability.to_sym) %>
    <%= link_to sprite_icon('add', l(:button_crm_new_deal)), crm_new_deal_path, :class => 'icon icon-add' %>
    <%= link_to sprite_icon('stats', l(:button_crm_open_board)), crm_deals_board_path, :class => 'icon icon-stats' %>
  <% end %>
</div>
<%= render :partial => 'crm/shared/nav' %>
<h2><%= h(title) %></h2>

<% if @query %>
  <%= form_tag crm_deals_path, :method => :get, :id => 'query_form' do %>
    <%= render :partial => 'queries/query_form' %>
  <% end %>
<% end %>

<% if @record_count.to_i.zero? %>
  <p class="nodata"><%= l(:text_crm_no_deals) %></p>
<% else %>
  <%= render_query_totals(@query) if @query %>
  <%= render :partial => 'crm/shared/list', :locals => {
        :records => @records, :query => @query, :record_type => 'deal'
      } %>
  <% pages = Redmine::Pagination::Paginator.new(@record_count.to_i, @limit.to_i, params[:page]) %>
  <span class="pagination"><%= pagination_links_full pages, nil %></span>
<% end %>

<% unless crm_capability.to_sym == :contractor || @query.nil? %>
  <% other_formats_links do |f| %>
    <%= f.link_to_with_query_parameters 'CSV' %>
  <% end %>
<% end %>

<% content_for :sidebar do %>
  <% if @query && [:admin, :staff, :viewer].include?(crm_capability.to_sym) %>
    <%= render_sidebar_queries(CrmDealQuery, nil) %>
  <% end %>
<% end %>
