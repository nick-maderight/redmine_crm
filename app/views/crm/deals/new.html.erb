<% html_title l(:button_crm_new_deal) %>
<h2><%= l(:button_crm_new_deal) %></h2>
<%= labelled_form_for @deal, :url => crm_deals_path, :html => {:id => 'crm-deal-form'} do |f| %>
  <%= error_messages_for @deal %>
  <%= render :partial => 'form', :locals => {:f => f} %>
  <p class="buttons"><%= submit_tag l(:button_create) %></p>
<% end %>
