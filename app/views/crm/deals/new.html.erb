<% html_title l(:button_crm_new_deal) %>
<%= render :partial => 'crm/shared/nav' %>
<h2><%= l(:button_crm_new_deal) %></h2>

<%= labelled_form_for @deal, :url => crm_deals_path, :html => {:id => 'crm-deal-form', :multipart => true} do |f| %>
  <%= error_messages_for @deal %>
  <%= render :partial => 'form', :locals => {:f => f} %>
  <p id="attachments_form"><label><%= l(:label_attachment_plural) %></label><%= render :partial => 'attachments/form', :locals => {:container => @deal} %></p>
  <p class="buttons"><%= submit_tag l(:button_create) %></p>
<% end %>
