<% html_title l(:button_crm_edit_deal) %>
<h2><%= l(:button_crm_edit_deal) %></h2>
<%= labelled_form_for @deal, :url => crm_deal_path(@deal), :html => {:method => :put, :id => 'crm-deal-form'} do |f| %>
  <%= error_messages_for @deal %>
  <%= render :partial => 'form', :locals => {:f => f} %>
  <%= hidden_field_tag :lock_version, @deal.lock_version %>
  <p class="buttons"><%= submit_tag l(:button_save) %></p>
<% end %>
