<% html_title l(:button_crm_edit_deal) %>
<%= render :partial => 'crm/shared/nav' %>
<h2><%= l(:button_crm_edit_deal) %></h2>

<%= labelled_form_for @deal, :url => crm_deal_path(@deal), :html => {:method => :put, :id => 'crm-deal-form', :multipart => true} do |f| %>
  <%= error_messages_for @deal %>
  <%= render :partial => 'form', :locals => {:f => f} %>
  <p id="attachments_form"><label><%= l(:label_attachment_plural) %></label><%= render :partial => 'attachments/form', :locals => {:container => @deal} %></p>
  <%= hidden_field_tag :lock_version, @deal.lock_version %>
  <p class="buttons"><%= submit_tag l(:button_save) %></p>
<% end %>
