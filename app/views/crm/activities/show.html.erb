<% title = @activity.subject.presence || l(:label_crm_activity) %>
<% html_title title %>
<%= render :partial => 'crm/shared/nav' %>

<div class="contextual">
  <% if [:admin, :staff].include?(crm_capability) %>
    <%= link_to sprite_icon('edit', l(:button_edit)), crm_edit_activity_path(@activity), :class => 'icon icon-edit' %>
    <% if @activity.archived? %>
      <%= form_tag crm_restore_activity_path(@activity), :method => :put, :class => 'inline-form' do %>
        <%= hidden_field_tag :lock_version, @activity.lock_version %>
        <%= submit_tag l(:button_crm_restore) %>
      <% end %>
    <% else %>
      <%= form_tag crm_archive_activity_path(@activity), :method => :put, :class => 'inline-form' do %>
        <%= hidden_field_tag :lock_version, @activity.lock_version %>
        <%= submit_tag l(:button_crm_archive) %>
      <% end %>
    <% end %>
  <% end %>
</div>

<h2 class="inline-block"><%= h(title) %></h2>
<span class="badge badge-status-activity"><%= l("label_crm_activity_#{@activity.kind}", :default => @activity.kind.to_s.humanize) %></span>
<% if @activity.archived? %><span class="badge badge-status-archived"><%= l(:text_crm_record_archived) %></span><% end %>

<div class="issue details">
  <div class="attributes">
    <%= crm_fields_rows do |rows|
      rows.left l(:field_crm_kind), l("label_crm_activity_#{@activity.kind}", :default => @activity.kind.to_s.humanize), :class => 'kind'
      rows.left l(:field_crm_subject), h(@activity.subject.presence || '-'), :class => 'subject'
      rows.left l(:field_crm_occurred_at), (@activity.occurred_at ? format_time(@activity.occurred_at) : '-'), :class => 'occurred-at'
      rows.left l(:field_crm_author), h(crm_owner_name(@activity.author_id)), :class => 'author'
      rows.right l(:field_crm_channel), (@activity.channel.present? ? l("label_crm_channel_#{@activity.channel}", :default => @activity.channel.to_s.humanize) : '-'), :class => 'channel'
      rows.right l(:field_crm_direction), (@activity.direction.present? ? l("label_crm_direction_#{@activity.direction}", :default => @activity.direction.to_s.humanize) : '-'), :class => 'direction'
      rows.right l(:field_crm_duration), (@activity.duration_minutes.present? ? @activity.duration_minutes : '-'), :class => 'duration'
      rows.right l(:field_crm_visibility), l("label_crm_visibility_#{@activity.visibility}", :default => @activity.visibility.to_s.humanize), :class => 'visibility'
    end %>
  </div>
</div>

<% if @activity.body.present? %>
  <div class="description">
    <p><strong><%= l(:field_crm_body) %></strong></p>
    <div class="wiki"><%= textilizable @activity, :body, :attachments => ([:admin, :staff, :viewer].include?(crm_capability) ? @activity.attachments : []) %></div>
  </div>
<% end %>

<section id="crm-account" class="crm-related">
  <h3><%= l(:label_crm_account) %></h3>
  <% if @activity.account %><p><%= crm_record_link(@activity.account) %></p><% else %><p class="nodata"><%= l(:text_crm_no_account) %></p><% end %>
</section>
<section id="crm-contact" class="crm-related">
  <h3><%= l(:label_crm_contact) %></h3>
  <% if @activity.contact %><p><%= crm_record_link(@activity.contact) %></p><% else %><p class="nodata"><%= l(:text_crm_no_contact) %></p><% end %>
</section>
<% unless crm_capability == :contractor %>
  <section id="crm-deal" class="crm-related">
    <h3><%= l(:label_crm_deal) %></h3>
    <% if @activity.deal %><p><%= crm_record_link(@activity.deal) %></p><% else %><p class="nodata"><%= l(:text_crm_no_deal) %></p><% end %>
  </section>
<% end %>

<% if @activity.account %>
  <% account_projects = @activity.account.account_projects.includes(:project).to_a %>
  <section id="crm-projects" class="crm-related">
    <h3><%= l(:label_crm_projects) %></h3>
    <% if account_projects.any? %><table class="list odd-even"><thead><tr><th><%= l(:field_crm_project) %></th><th><%= l(:field_identifier) %></th></tr></thead><tbody>
      <% account_projects.each do |account_project| %><% project = account_project.project %><% next unless project %><tr><td><%= link_to h(project.name), project_path(project) %></td><td><%= h(project.identifier) %></td></tr><% end %>
    </tbody></table><% else %><p class="nodata"><%= l(:text_crm_no_linked_projects) %></p><% end %>
  </section>
<% end %>

<% if [:admin, :staff, :viewer].include?(crm_capability) %>
  <section id="crm-files" class="crm-related">
    <h3><%= l(:label_crm_files) %></h3>
    <% if @activity.attachments.any? %><%= link_to_attachments @activity, :thumbnails => true %><% else %><p class="nodata"><%= l(:text_crm_no_attachments) %></p><% end %>
  </section>
<% end %>

<%= render :partial => 'crm/shared/timeline', :locals => {:record => @activity, :timeline => @timeline, :composer => false} %>
