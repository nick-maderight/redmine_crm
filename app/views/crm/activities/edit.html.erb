<% html_title l(:button_crm_edit_activity) %>
<h2><%= l(:button_crm_edit_activity) %></h2>
<%= labelled_form_for @activity, :url => crm_activity_path(@activity), :html => {:method => :put, :id => 'crm-activity-form'} do |f| %>
  <%= error_messages_for @activity %>
  <%= render :partial => 'form', :locals => {:f => f} %>
  <%= hidden_field_tag :lock_version, @activity.lock_version %>
  <p class="buttons"><%= submit_tag l(:button_save) %></p>
<% end %>
