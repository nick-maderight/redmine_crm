<% account = local_assigns[:account] || @account || @record %>
<% projects = local_assigns[:projects] || (defined?(@projects) ? @projects : []) %>
<% account_projects = local_assigns[:account_projects] || (account.respond_to?(:account_projects) ? account.account_projects : []) %>

<section class="crm-related crm-project-links-panel" aria-labelledby="crm-project-links-heading">
  <h3 id="crm-project-links-heading"><%= l(:label_crm_linked_projects) %></h3>
  <% if Array(account_projects).any? %>
    <table class="list odd-even">
      <thead><tr><th><%= l(:field_crm_project) %></th><th><%= l(:field_identifier) %></th><% if Crm::Access.staff?(User.current) %><th><%= l(:label_crm_actions) %></th><% end %></tr></thead>
      <tbody>
        <% Array(account_projects).each do |account_project| %>
          <%= render :partial => 'crm/account_projects/project', :locals => {:account_project => account_project} %>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="nodata"><%= l(:text_crm_no_linked_projects) %></p>
  <% end %>

  <% if Crm::Access.staff?(User.current) %>
    <%= form_tag crm_account_projects_path(account), :method => :post, :class => 'box tabular crm-inline-form' do %>
      <p>
        <%= label_tag 'crm_account_project_id', l(:field_crm_project) %>
        <%= select_tag 'account_project[project_id]', options_from_collection_for_select(Array(projects), :id, :name), :id => 'crm_account_project_id', :prompt => l(:prompt_crm_select_project), :required => true %>
      </p>
      <p class="buttons"><%= submit_tag l(:button_crm_link_project) %></p>
    <% end %>
  <% end %>
</section>
