<% source = @source %>
<% account_merge = source.is_a?(CrmAccount) %>
<% source_path = account_merge ? crm_account_path(source) : crm_contact_path(source) %>
<% merge_path = account_merge ? crm_merge_account_path(source) : crm_merge_contact_path(source) %>
<% search_path = account_merge ? crm_accounts_path : crm_contacts_path %>
<% target_id = params[:target_id].presence %>
<% target = if target_id && source.class.respond_to?(:visible)
              source.class.visible(User.current).where(:id => target_id).first
            end %>
<% html_title l(account_merge ? :heading_crm_merge_account : :heading_crm_merge_contact) %>
<%= render :partial => 'crm/shared/nav' %>

<div class="contextual"><%= link_to l(:button_crm_cancel), source_path, :class => 'icon icon-cancel' %></div>
<h2><%= l(account_merge ? :heading_crm_merge_account : :heading_crm_merge_contact) %></h2>

<div class="details">
  <div class="attributes">
    <%= crm_fields_rows do |rows|
      rows.left l(:label_crm_merge_source), crm_record_link(source), :class => 'source'
      rows.right l(:label_crm_merge_survivor), (target ? crm_record_link(target) : '-'), :class => 'survivor'
    end %>
  </div>
</div>

<% if @preview.present? %>
  <div class="box crm-merge-preview">
    <h3><%= l(:heading_crm_merge_preview) %></h3>
    <table class="list odd-even">
      <thead><tr><th><%= l(:field_crm_relation) %></th><th><%= l(:field_crm_count) %></th></tr></thead>
      <tbody>
        <% @preview.each do |relation, count| %>
          <tr><th scope="row"><%= l("label_crm_merge_#{relation}", :default => relation.to_s.humanize) %></th><td><%= count %></td></tr>
        <% end %>
      </tbody>
    </table>
    <%= form_tag merge_path, :method => :post, :class => 'box tabular' do %>
      <%= hidden_field_tag :target_id, target_id %>
      <p class="buttons">
        <%= submit_tag l(:button_crm_confirm_merge), :class => 'button-positive', :data => {:confirm => l(:button_crm_confirm_merge)} %>
        <%= link_to l(:button_crm_choose_different_survivor), merge_path, :class => 'button' %>
      </p>
    <% end %>
  </div>
<% else %>
  <div class="box tabular crm-merge-picker">
    <h3><%= l(:heading_crm_choose_survivor) %></h3>
    <p class="help"><%= l(:text_crm_merge_picker_help) %></p>
    <%= form_tag merge_path, :method => :get, :data => {:crm_merge_picker => true, :crm_search_url => search_path, :crm_source_id => source.id} do %>
      <p>
        <%= label_tag :crm_merge_search, l(:field_crm_search_records) %>
        <%= search_field_tag :crm_merge_search, nil, :autocomplete => 'off', :placeholder => l(:field_crm_search_records), :data => {:crm_merge_search => true} %>
      </p>
      <div class="crm-merge-results" data-crm-picker-results role="listbox" aria-label="<%= h(l(:label_crm_merge_candidates)) %>"></div>
      <%= hidden_field_tag :target_id, target_id, :data => {:crm_merge_target_id => true} %>
      <p class="crm-selected-target" data-crm-selected-target><%= crm_record_link(target) if target %></p>
      <p class="buttons">
        <%= submit_tag l(:button_crm_preview_merge), :class => 'button-positive', :data => {:crm_merge_submit => true}, :disabled => target.nil? %>
        <%= link_to l(:button_crm_cancel), source_path, :class => 'button' %>
      </p>
    <% end %>
  </div>
<% end %>
