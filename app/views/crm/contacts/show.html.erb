<% display_name = @contact.name.presence || l(:label_crm_contact) %>
<% html_title display_name %>
<%= render :partial => 'crm/shared/nav' %>

<div class="contextual">
  <% if [:admin, :staff].include?(crm_capability) %>
    <%= link_to sprite_icon('edit', l(:button_edit)), crm_edit_contact_path(@contact), :class => 'icon icon-edit' %>
    <%= link_to sprite_icon('add', l(:button_crm_new_deal)), crm_new_deal_path(:contact_id => @contact.id), :class => 'icon icon-add' %>
    <%= link_to sprite_icon('reload', l(:button_crm_merge_into)), crm_merge_contact_path(@contact), :class => 'icon icon-reload' unless @contact.archived? %>
    <% if @contact.archived? %>
      <%= form_tag crm_restore_contact_path(@contact), :method => :put, :class => 'inline-form' do %>
        <%= hidden_field_tag :lock_version, @contact.lock_version %>
        <%= submit_tag l(:button_crm_restore) %>
      <% end %>
    <% else %>
      <%= form_tag crm_archive_contact_path(@contact), :method => :put, :class => 'inline-form' do %>
        <%= hidden_field_tag :lock_version, @contact.lock_version %>
        <%= submit_tag l(:button_crm_archive) %>
      <% end %>
    <% end %>
    <%= link_to l(:button_crm_add_activity), '#history', :class => 'icon icon-comment' %>
  <% end %>
</div>

<h2 class="inline-block"><%= h(display_name) %></h2>
<span class="badge badge-status-contact"><%= l(:label_crm_contact) %></span>
<% if @contact.archived? %><span class="badge badge-status-archived"><%= l(:text_crm_record_archived) %></span><% end %>

<div class="issue details">
  <div class="attributes">
    <%= crm_fields_rows do |rows|
      rows.left l(:field_crm_account), (@contact.account ? crm_record_link(@contact.account) : '-'), :class => 'account'
      rows.left l(:field_crm_first_name), h(@contact.first_name.presence || '-'), :class => 'first-name'
      rows.left l(:field_crm_last_name), h(@contact.last_name.presence || '-'), :class => 'last-name'
      rows.left l(:field_crm_email), (@contact.email.present? ? mail_to(@contact.email) : '-'), :class => 'email'
      rows.right l(:field_crm_phone), h(@contact.phone.presence || '-'), :class => 'phone'
      rows.right l(:field_crm_job_title), h(@contact.job_title.presence || '-'), :class => 'job-title'
      rows.right l(:field_crm_city), h(@contact.city.presence || '-'), :class => 'city'
      rows.right l(:field_crm_owner), (@contact.owner_id.present? ? h(crm_owner_name(@contact.owner_id)) : '-'), :class => 'owner'
      rows.right l(:field_crm_linkedin), (@contact.linkedin_url.present? ? link_to(h(@contact.linkedin_url), @contact.linkedin_url, :rel => 'noopener') : '-'), :class => 'linkedin'
      rows.right l(:field_crm_x), (@contact.x_url.present? ? link_to(h(@contact.x_url), @contact.x_url, :rel => 'noopener') : '-'), :class => 'x'
    end %>
    <%= render_half_width_custom_fields_rows(@contact) %>
  </div>
</div>
<%= render_full_width_custom_fields_rows(@contact) %>

<% unless crm_capability == :contractor %>
  <% deals = @contact.deals.respond_to?(:active) ? @contact.deals.active.order(:name) : @contact.deals.order(:name) %>
  <section id="crm-deals" class="crm-related">
    <h3><%= l(:label_crm_deals) %></h3>
    <% if deals.any? %>
      <table class="list odd-even">
        <thead><tr><th><%= l(:field_crm_name) %></th><th><%= l(:field_crm_stage) %></th><% if crm_money? %><th><%= l(:field_crm_amount) %></th><% end %><th><%= l(:field_crm_next_action) %></th><th><%= l(:field_crm_next_action_on) %></th></tr></thead>
        <tbody>
          <% deals.each do |deal| %>
            <tr>
              <td><%= crm_record_link(deal) %></td>
              <td><span class="badge badge-status-<%= deal.stage_kind.to_s.dasherize %>"><%= h(deal.stage && deal.stage.name) %></span></td>
              <% if crm_money? %><td><%= crm_money(deal.amount_cents, deal.currency) if deal.amount_cents.present? %></td><% end %>
              <td><%= h(deal.next_action) %></td>
              <td><%= format_date(deal.next_action_on) if deal.next_action_on %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %><p class="nodata"><%= l(:text_crm_no_deals) %></p><% end %>
  </section>
<% end %>

<% activities = @contact.activities.respond_to?(:visible) ? @contact.activities.visible(User.current) : @contact.activities %>
<% activities = activities.respond_to?(:active) ? activities.active.order(:occurred_at => :desc, :id => :desc) : activities.order(:occurred_at => :desc, :id => :desc) %>
<section id="crm-activities" class="crm-related">
  <h3><%= l(:label_crm_activities) %></h3>
  <% if activities.any? %>
    <table class="list odd-even">
      <thead><tr><th><%= l(:field_crm_occurred_at) %></th><th><%= l(:field_crm_kind) %></th><th><%= l(:field_crm_subject) %></th><th><%= l(:field_crm_body) %></th></tr></thead>
      <tbody>
        <% activities.limit(25).each do |activity| %>
          <tr>
            <td><%= link_to format_time(activity.occurred_at), crm_activity_path(activity) %></td>
            <td><%= l("label_crm_activity_#{activity.kind}", :default => activity.kind.to_s.humanize) %></td>
            <td><%= h(activity.subject) %></td>
            <td><%= h(truncate(activity.body.to_s, :length => 100)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %><p class="nodata"><%= l(:text_crm_no_activities) %></p><% end %>
</section>

<% if @contact.account %>
  <% projects = @contact.account.account_projects.includes(:project).to_a %>
  <section id="crm-projects" class="crm-related">
    <h3><%= l(:label_crm_projects) %></h3>
    <% if projects.any? %>
      <table class="list odd-even"><thead><tr><th><%= l(:field_crm_project) %></th><th><%= l(:field_identifier) %></th></tr></thead><tbody>
        <% projects.each do |account_project| %><% project = account_project.project %><% next unless project %><tr><td><%= link_to h(project.name), project_path(project) %></td><td><%= h(project.identifier) %></td></tr><% end %>
      </tbody></table>
    <% else %><p class="nodata"><%= l(:text_crm_no_linked_projects) %></p><% end %>
  </section>
<% end %>

<% links = @contact.links.includes(:issue).to_a %>
<% issues = if [:admin, :staff].include?(crm_capability) && defined?(Issue)
              Issue.visible(User.current).order(:id => :desc).limit(200)
            else
              []
            end %>
<%= render :partial => 'crm/links/form', :locals => {:record => @contact, :links => links, :issues => issues} %>

<% if [:admin, :staff, :viewer].include?(crm_capability) %>
  <section id="crm-files" class="crm-related">
    <h3><%= l(:label_crm_files) %></h3>
    <% if @contact.attachments.any? %><%= link_to_attachments @contact, :thumbnails => true %><% else %><p class="nodata"><%= l(:text_crm_no_attachments) %></p><% end %>
  </section>
<% end %>

<%= render :partial => 'crm/shared/timeline', :locals => {:record => @contact, :timeline => @timeline, :composer => true} %>
