<% html_title l(:button_crm_new_contact) %>
<h2><%= l(:button_crm_new_contact) %></h2>
<%= labelled_form_for @contact, :url => crm_contacts_path, :html => {:id => 'crm-contact-form'} do |f| %>
  <%= error_messages_for @contact %>
  <%= render :partial => 'form', :locals => {:f => f} %>
  <p class="buttons"><%= submit_tag l(:button_create) %></p>
<% end %>
