<% html_title l(:button_crm_edit_contact) %>
<%= render :partial => 'crm/shared/nav' %>
<h2><%= l(:button_crm_edit_contact) %></h2>

<%= labelled_form_for @contact, :url => crm_contact_path(@contact), :html => {:method => :put, :id => 'crm-contact-form', :multipart => true} do |f| %>
  <%= error_messages_for @contact %>
  <%= render :partial => 'form', :locals => {:f => f} %>
  <p id="attachments_form"><label><%= l(:label_attachment_plural) %></label><%= render :partial => 'attachments/form', :locals => {:container => @contact} %></p>
  <%= hidden_field_tag :lock_version, @contact.lock_version %>
  <p class="buttons"><%= submit_tag l(:button_save) %></p>
<% end %>
