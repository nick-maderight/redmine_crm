<% crm_link = local_assigns[:crm_link] || local_assigns[:link] %>
<% target = crm_link && (crm_link.account || crm_link.contact || crm_link.deal) %>
<% issue = crm_link && crm_link.issue %>
<% if target && issue && target.visible?(User.current) %>
  <tr id="crm-link-<%= crm_link.id %>">
    <td><%= crm_record_link(target) %></td>
    <td><%= link_to "##{issue.id}", issue_path(issue) %></td>
    <td><%= h(issue.subject) %></td>
    <% if Crm::Access.staff?(User.current) %>
      <td><%= button_to l(:button_crm_unlink_issue), crm_link_path(crm_link), :method => :delete, :class => 'icon icon-del', :data => {:confirm => l(:text_crm_confirm_unlink_issue)} %></td>
    <% end %>
  </tr>
<% end %>
