<%
  query_for_columns = query
  unless query_for_columns
    query_for_columns = case record_type.to_s
                        when 'account' then CrmAccountQuery.new
                        when 'contact' then CrmContactQuery.new
                        when 'deal' then CrmDealQuery.new
                        when 'activity' then CrmActivityQuery.new
                        end
  end
  columns = query_for_columns ? query_for_columns.inline_columns : []
  block_columns = query_for_columns ? query_for_columns.block_columns : []
  context_menu_enabled = query.present? && [:admin, :staff].include?(crm_capability.to_sym)
  column_count = columns.size + (context_menu_enabled ? 2 : 0)
%>
<% if context_menu_enabled %>
  <%= form_tag({}, :data => {:cm_url => crm_context_menu_path(record_type)}) do -%>
    <%= hidden_field_tag 'back_url', url_for(:params => request.query_parameters), :id => nil %>
    <%= query_columns_hidden_tags(query) %>
<% end %>
<% end %>
<div class="autoscroll">
  <table class="list crm-<%= record_type.to_s.pluralize %> odd-even <%= query_for_columns&.css_classes %>">
    <thead>
      <tr>
        <% if context_menu_enabled %>
          <th class="checkbox hide-when-print">
            <%= check_box_tag 'check_all', '', false, :class => 'toggle-selection',
                              :title => "#{l(:button_check_all)} / #{l(:button_uncheck_all)}" %>
          </th>
        <% end %>
        <% columns.each do |column| %>
          <%= column_header(query_for_columns, column) %>
        <% end %>
        <% if context_menu_enabled %>
          <th class="buttons hide-when-print"></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% crm_grouped_list(records, query) do |record, level, group_name, group_count, group_totals| -%>
        <% if group_name %>
          <% reset_cycle %>
          <tr class="group open">
            <td colspan="<%= column_count %>">
              <span class="expander icon icon-expanded" onclick="toggleRowGroup(this);"><%= sprite_icon('angle-down') %></span>
              <span class="name"><%= group_name %></span>
              <% if group_count %><span class="badge badge-count count"><%= group_count %></span><% end %>
              <span class="totals"><%= group_totals %></span>
              <%= link_to_function "#{l(:button_collapse_all)}/#{l(:button_expand_all)}",
                                   'toggleAllRowGroups(this)', :class => 'toggle-all' %>
            </td>
          </tr>
        <% end %>
        <tr id="crm-<%= record_type %>-<%= record.id %>" class="<%= 'hascontextmenu ' if context_menu_enabled %><%= cycle('odd', 'even') %><%= ' archived' if record.respond_to?(:archived_on) && record.archived_on.present? %><%= level.to_i > 0 ? " idnt idnt-#{level}" : nil %>">
          <% if context_menu_enabled %>
            <td class="checkbox hide-when-print"><%= check_box_tag('ids[]', record.id, false, :id => nil) %></td>
          <% end %>
          <% columns.each do |column| %>
            <%= content_tag('td', crm_column_content(column, record), :class => column.css_classes) %>
          <% end %>
          <% if context_menu_enabled %>
            <td class="buttons hide-when-print"><%= link_to_context_menu %></td>
          <% end %>
        </tr>
        <% block_columns.each do |column| %>
          <% if (text = column_content(column, record)) && text.present? %>
            <tr class="<%= current_cycle %>">
              <td colspan="<%= column_count %>" class="<%= column.css_classes %> block_column">
                <% if block_columns.size > 1 %><span><%= column.caption %></span><% end %>
                <%= text %>
              </td>
            </tr>
          <% end %>
        <% end %>
      <% end -%>
    </tbody>
  </table>
</div>
