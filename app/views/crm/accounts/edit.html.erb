<% html_title l(:button_crm_edit_account) %>
<h2><%= l(:button_crm_edit_account) %></h2>
<%= labelled_form_for @account, :url => crm_account_path(@account), :html => {:method => :put, :id => 'crm-account-form'} do |f| %>
  <%= error_messages_for @account %>
  <%= render :partial => 'form', :locals => {:f => f} %>
  <%= hidden_field_tag :lock_version, @account.lock_version %>
  <p class="buttons"><%= submit_tag l(:button_save) %></p>
<% end %>
