<% html_title @account.name %>

<div class="contextual">
  <% if [:admin, :staff].include?(crm_capability) %>
    <%= link_to l(:button_edit), crm_edit_account_path(@account), :class => 'icon icon-edit' %>
    <%= link_to l(:button_crm_new_contact), crm_new_contact_path(:account_id => @account.id), :class => 'icon icon-add' %>
    <%= link_to l(:button_crm_new_deal), crm_new_deal_path(:account_id => @account.id), :class => 'icon icon-add' %>
    <%= link_to l(:button_crm_merge_into), crm_merge_account_path(@account), :class => 'icon icon-reload' unless @account.archived? %>
    <% if @account.archived? %>
      <%= form_tag crm_restore_account_path(@account), :method => :put, :class => 'inline-form' do %>
        <%= hidden_field_tag :lock_version, @account.lock_version %>
        <%= submit_tag l(:button_crm_restore) %>
      <% end %>
    <% else %>
      <%= form_tag crm_archive_account_path(@account), :method => :put, :class => 'inline-form' do %>
        <%= hidden_field_tag :lock_version, @account.lock_version %>
        <%= submit_tag l(:button_crm_archive) %>
      <% end %>
    <% end %>
  <% end %>
</div>

<h2><%= h(@account.name) %></h2>
<% if @account.archived? %><p class="warning"><%= l(:text_crm_record_archived) %></p><% end %>

<div class="crm-record-layout">
  <section class="box crm-properties">
    <h3><%= l(:label_crm_properties) %></h3>
    <dl>
      <dt><%= l(:field_crm_name) %></dt><dd><%= h(@account.name) %></dd>
      <% [[:domain, :field_crm_domain], [:website, :field_crm_website], [:phone, :field_crm_phone], [:status, :field_crm_status], [:address, :field_crm_address]].each do |attribute, label| %>
        <% value = @account.public_send(attribute) if @account.respond_to?(attribute) %>
        <% if value.present? %><% display_value = attribute == :status ? (l("label_crm_status_#{value}") rescue h(value)) : h(value) %><dt><%= l(label) %></dt><dd><%= display_value %></dd><% end %>
      <% end %>
      <% if @account.owner_id.present? %><dt><%= l(:field_crm_owner) %></dt><dd><%= h(crm_owner_name(@account.owner_id)) %></dd><% end %>
      <% if @account.description.present? %><dt><%= l(:field_crm_description) %></dt><dd class="wiki"><%= simple_format h(@account.description) %></dd><% end %>
      <% render_custom_field_values(@account) do |field, value| %>
        <dt class="<%= field.css_classes %>"><%= h(field.name) %></dt><dd class="<%= field.css_classes %>"><%= value %></dd>
      <% end %>
    </dl>
  </section>

  <section class="box crm-timeline">
    <h3><%= l(:label_crm_timeline) %></h3>
    <% if [:admin, :staff].include?(crm_capability) %>
      <%= form_for CrmActivity.new, :as => :activity, :url => crm_activities_path, :html => {:class => 'crm-timeline-composer'} do |f| %>
        <%= hidden_field_tag 'activity[account_id]', @account.id %>
        <p><%= f.select :kind, [['note', 'note'], ['call', 'call'], ['meeting', 'meeting'], ['message', 'message']].map { |value, key| [l("label_crm_activity_#{key}"), key] }, :include_blank => false %></p>
        <p><%= f.text_area :body, :rows => 4, :cols => 60, :placeholder => l(:text_crm_activity_body_placeholder) %></p>
        <p><%= f.datetime_local_field :occurred_at, :value => (Time.zone.now.strftime('%Y-%m-%dT%H:%M')) %></p>
        <p class="buttons"><%= f.submit l(:button_crm_add_activity) %></p>
      <% end %>
    <% end %>
    <% if @timeline.to_a.any? %>
      <ol class="crm-timeline-list">
        <% @timeline.to_a.each do |entry| %>
          <% item = entry[:item]; kind = entry[:kind].to_s; at = entry[:at] || (item.respond_to?(:created_on) ? item.created_on : nil) %>
          <li class="crm-timeline-item crm-timeline-<%= kind %>">
            <time datetime="<%= at&.iso8601 %>"><%= format_time(at) if at %></time>
            <% if kind == 'activity' %>
              <strong><%= l("label_crm_activity_#{item.kind}") rescue h(item.kind) %></strong>
              <% if item.author_id.present? %><span class="actor"><%= h(crm_owner_name(item.author_id)) %></span><% end %>
              <% if item.subject.present? %><h4><%= h(item.subject) %></h4><% end %>
              <div class="wiki"><%= simple_format h(item.body.to_s) %></div>
            <% else %>
              <strong><%= l(:label_crm_change) %></strong>
              <span><%= h(item.prop_key.to_s) %></span>
              <% if item.respond_to?(:user_id) && item.user_id.present? %><span class="actor"><%= h(crm_owner_name(item.user_id)) %></span><% end %>
              <% if item.value.present? %><div><%= h(item.value) %></div><% end %>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="nodata"><%= l(:text_crm_no_timeline_entries) %></p>
    <% end %>
  </section>
</div>

<div class="tabs crm-record-tabs">
  <ul>
    <li><a href="#crm-contacts"><%= l(:label_crm_contacts) %></a></li>
    <% unless crm_capability == :contractor %><li><a href="#crm-deals"><%= l(:label_crm_deals) %></a></li><% end %>
    <li><a href="#crm-issues"><%= l(:label_crm_issues) %></a></li>
    <li><a href="#crm-projects"><%= l(:label_crm_projects) %></a></li>
    <% if [:admin, :staff, :viewer].include?(crm_capability) %><li><a href="#crm-files"><%= l(:label_crm_files) %></a></li><% end %>
    <% if [:admin, :staff, :viewer].include?(crm_capability) %><li><a href="#crm-history"><%= l(:label_crm_history) %></a></li><% end %>
  </ul>

  <section id="crm-contacts" class="crm-tab-panel">
    <h3><%= l(:label_crm_contacts) %></h3>
    <% contacts = @account.contacts.to_a %>
    <% if contacts.any? %><ul><% contacts.each do |contact| %><li><%= crm_record_link(contact) %></li><% end %></ul><% else %><p class="nodata"><%= l(:text_crm_no_contacts) %></p><% end %>
  </section>
  <% unless crm_capability == :contractor %>
    <section id="crm-deals" class="crm-tab-panel">
      <h3><%= l(:label_crm_deals) %></h3>
      <% deals = @account.deals.to_a %>
      <% if deals.any? %><ul><% deals.each do |deal| %><li><%= crm_record_link(deal) %></li><% end %></ul><% else %><p class="nodata"><%= l(:text_crm_no_deals) %></p><% end %>
    </section>
  <% end %>
  <section id="crm-issues" class="crm-tab-panel">
    <h3><%= l(:label_crm_issues) %></h3>
    <% links = @account.links.to_a %>
    <% if links.any? %><ul><% links.each do |link| %><li><%= link_to h(link.issue.subject), issue_path(link.issue) if link.issue %></li><% end %></ul><% else %><p class="nodata"><%= l(:text_crm_no_linked_issues) %></p><% end %>
  </section>
  <section id="crm-projects" class="crm-tab-panel">
    <h3><%= l(:label_crm_projects) %></h3>
    <% projects = @account.projects.to_a %>
    <% if projects.any? %><ul><% projects.each do |project| %><li><%= link_to h(project.name), project_path(project) %></li><% end %></ul><% else %><p class="nodata"><%= l(:text_crm_no_linked_projects) %></p><% end %>
  </section>
  <% if [:admin, :staff, :viewer].include?(crm_capability) %>
    <section id="crm-files" class="crm-tab-panel">
      <h3><%= l(:label_crm_files) %></h3>
      <% if @attachments.to_a.any? %><%= link_to_attachments @account, :thumbnails => true %><% else %><p class="nodata"><%= l(:text_crm_no_attachments) %></p><% end %>
      <% if [:admin, :staff].include?(crm_capability) %><%= render :partial => 'attachments/form', :locals => {:container => @account} %><% end %>
    </section>
    <section id="crm-history" class="crm-tab-panel">
      <h3><%= l(:label_crm_history) %></h3>
      <% if @history_rows.to_a.any? %>
        <table class="list crm-history"><thead><tr><th><%= l(:field_crm_changed_at) %></th><th><%= l(:field_crm_changed_by) %></th><th><%= l(:field_crm_property) %></th><th><%= l(:field_crm_old_value) %></th><th><%= l(:field_crm_new_value) %></th></tr></thead><tbody>
          <% @history_rows.to_a.each do |row| %><% redacted = row[:redacted] || row['redacted'] %><tr><td><%= format_time(row[:at] || row['at']) %></td><td><%= h(row[:user] || row['user']) %></td><td><%= h(row[:prop_key] || row['prop_key']) %></td><td><%= redacted ? l(:text_crm_redacted_value) : h(row[:old_value] || row['old_value']) %></td><td><%= redacted ? l(:text_crm_redacted_value) : h(row[:value] || row['value']) %></td></tr><% end %>
        </tbody></table>
      <% else %><p class="nodata"><%= l(:text_crm_no_history) %></p><% end %>
    </section>
  <% end %>
</div>
