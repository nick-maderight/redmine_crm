<% html_title @account.name %>
<%= render :partial => 'crm/shared/nav' %>

<div class="contextual">
  <% if [:admin, :staff].include?(crm_capability) %>
    <%= link_to sprite_icon('edit', l(:button_edit)), crm_edit_account_path(@account), :class => 'icon icon-edit' %>
    <%= link_to sprite_icon('add', l(:button_crm_new_contact)), crm_new_contact_path(:account_id => @account.id), :class => 'icon icon-add' %>
    <%= link_to sprite_icon('add', l(:button_crm_new_deal)), crm_new_deal_path(:account_id => @account.id), :class => 'icon icon-add' %>
    <%= link_to sprite_icon('reload', l(:button_crm_merge_into)), crm_merge_account_path(@account), :class => 'icon icon-reload' unless @account.archived? %>
    <% if @account.archived? %>
      <%= form_tag crm_restore_account_path(@account), :method => :put, :class => 'inline-form' do %>
        <%= hidden_field_tag :lock_version, @account.lock_version %>
        <%= submit_tag l(:button_crm_restore) %>
      <% end %>
    <% else %>
      <%= form_tag crm_archive_account_path(@account), :method => :put, :class => 'inline-form' do %>
        <%= hidden_field_tag :lock_version, @account.lock_version %>
        <%= submit_tag l(:button_crm_archive) %>
      <% end %>
    <% end %>
  <% end %>
  <%= link_to l(:button_crm_add_activity), '#history', :class => 'icon icon-comment' if [:admin, :staff].include?(crm_capability) %>
</div>

<h2 class="inline-block"><%= h(@account.name) %></h2>
<% account_badge_status = @account.status.to_s == 'past_client' ? 'closed' : 'open' %>
<span class="badge badge-status-<%= account_badge_status %>"><%= l("label_crm_status_#{@account.status}", :default => @account.status.to_s.humanize) %></span>
<% if @account.archived? %><span class="badge badge-status-archived"><%= l(:text_crm_record_archived) %></span><% end %>

<div class="issue details">
  <div class="attributes">
    <%= crm_fields_rows do |rows|
      rows.left l(:field_crm_name), h(@account.name), :class => 'name'
      rows.left l(:field_crm_domain), h(@account.domain.presence || '-'), :class => 'domain'
      rows.left l(:field_crm_website), (@account.website.present? ? link_to(h(@account.website), @account.website, :rel => 'noopener') : '-'), :class => 'website'
      rows.left l(:field_crm_phone), h(@account.phone.presence || '-'), :class => 'phone'
      rows.right l(:field_crm_status), l("label_crm_status_#{@account.status}", :default => @account.status.to_s.humanize), :class => 'status'
      rows.right l(:field_crm_owner), (@account.owner_id.present? ? h(crm_owner_name(@account.owner_id)) : '-'), :class => 'owner'
      rows.right l(:field_crm_address), h(@account.address.presence || '-'), :class => 'address'
    end %>
    <%= render_half_width_custom_fields_rows(@account) %>
  </div>
</div>

<% if @account.description.present? %>
  <div class="description">
    <p><strong><%= l(:field_crm_description) %></strong></p>
    <div class="wiki"><%= textilizable @account, :description, :attachments => ([:admin, :staff, :viewer].include?(crm_capability) ? @account.attachments : []) %></div>
  </div>
<% end %>
<%= render_full_width_custom_fields_rows(@account) %>

<% contacts = @account.contacts.respond_to?(:active) ? @account.contacts.active.order(:last_name, :first_name) : @account.contacts.order(:last_name, :first_name) %>
<section id="crm-contacts" class="crm-related">
  <h3><%= l(:label_crm_contacts) %></h3>
  <% if contacts.any? %>
    <table class="list odd-even">
      <thead><tr><th><%= l(:field_crm_name) %></th><th><%= l(:field_crm_email) %></th><th><%= l(:field_crm_job_title) %></th></tr></thead>
      <tbody>
        <% contacts.each do |contact| %>
          <tr>
            <td><%= crm_record_link(contact) %></td>
            <td><%= mail_to contact.email if contact.email.present? %></td>
            <td><%= h(contact.job_title) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %><p class="nodata"><%= l(:text_crm_no_contacts) %></p><% end %>
</section>

<% unless crm_capability == :contractor %>
  <% deals = @account.deals.respond_to?(:active) ? @account.deals.active.order(:name) : @account.deals.order(:name) %>
  <section id="crm-deals" class="crm-related">
    <h3><%= l(:label_crm_deals) %></h3>
    <% if deals.any? %>
      <table class="list odd-even">
        <thead><tr><th><%= l(:field_crm_name) %></th><th><%= l(:field_crm_stage) %></th><% if crm_money? %><th><%= l(:field_crm_amount) %></th><% end %><th><%= l(:field_crm_next_action) %></th><th><%= l(:field_crm_next_action_on) %></th></tr></thead>
        <tbody>
          <% deals.each do |deal| %>
            <tr>
              <td><%= crm_record_link(deal) %></td>
              <td><span class="badge badge-status-<%= deal.stage_kind.to_s.dasherize %>"><%= h(deal.stage && deal.stage.name) %></span></td>
              <% if crm_money? %><td><%= crm_money(deal.amount_cents, deal.currency) if deal.amount_cents.present? %></td><% end %>
              <td><%= h(crm_humanize_enum(deal.next_action)) %></td>
              <td><%= format_date(deal.next_action_on) if deal.next_action_on %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %><p class="nodata"><%= l(:text_crm_no_deals) %></p><% end %>
  </section>
<% end %>

<% account_projects = @account.account_projects.includes(:project).to_a %>
<% linked_project_ids = account_projects.map(&:project_id) %>
<% projects = if [:admin, :staff].include?(crm_capability)
                Project.visible(User.current).where.not(:id => linked_project_ids).order(:name).limit(200)
              else
                []
              end %>
<%= render :partial => 'crm/account_projects/form', :locals => {:account => @account, :projects => projects, :account_projects => account_projects} %>

<% links = @account.links.includes(:issue).to_a %>
<% issues = if [:admin, :staff].include?(crm_capability) && defined?(Issue)
              Issue.visible(User.current).order(:id => :desc).limit(200)
            else
              []
            end %>
<%= render :partial => 'crm/links/form', :locals => {:record => @account, :links => links, :issues => issues} %>

<% if [:admin, :staff, :viewer].include?(crm_capability) %>
  <section id="crm-files" class="crm-related">
    <h3><%= l(:label_crm_files) %></h3>
    <% if @account.attachments.any? %><%= link_to_attachments @account, :thumbnails => true %><% else %><p class="nodata"><%= l(:text_crm_no_attachments) %></p><% end %>
  </section>
<% end %>

<%= render :partial => 'crm/shared/timeline', :locals => {:record => @account, :timeline => @timeline, :composer => true} %>
