<% html_title(@query && @query.persisted? ? @query.name : l(:label_crm_accounts)) %>

<div class="contextual">
  <% if [:admin, :staff].include?(crm_capability) %>
    <%= link_to l(:button_crm_new_account), crm_new_account_path, :class => 'icon icon-add' %>
  <% end %>
</div>
<h2><%= @query && @query.persisted? ? h(@query.name) : l(:label_crm_accounts) %></h2>

<% if @query %>
  <%= form_tag crm_accounts_path, :method => :get, :id => 'query_form' do %>
    <%= render :partial => 'queries/query_form' %>
  <% end %>
<% end %>

<% if @record_count.to_i.zero? %>
  <p class="nodata"><%= l(:text_crm_no_accounts) %></p>
<% end %>
<%= render :partial => 'grid' %>

<% content_for :sidebar do %>
  <% if [:admin, :staff, :viewer].include?(crm_capability) && defined?(CrmAccountQuery) %>
    <%= render_sidebar_queries(CrmAccountQuery, nil) %>
  <% end %>
<% end %>

<% content_for :header_tags do %>
  <%= javascript_include_tag 'tabulator', 'sortable', 'crm', :plugin => 'redmine_crm' %>
<% end %>
