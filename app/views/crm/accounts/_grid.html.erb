<% editable = %w[name owner owner_id status] %>
<% rows = @records.to_a.map do |record|
     values = record.respond_to?(:attributes) ? record.attributes : {:id => record.id, :lock_version => record.lock_version}
     if values['owner_id']
       values['owner'] = crm_owner_name(values['owner_id'])
       values.delete('owner_id')
     end
     values
   end %>
<% columns = if @query && @query.respond_to?(:available_columns)
               @query.available_columns.map do |column|
                 name = column.name.to_s
                 {:field => name, :title => column.caption.to_s, :editable => editable.include?(name)}
               end
             else
               [
                 {:field => 'name', :title => l(:field_crm_name), :editable => true},
                 {:field => 'domain', :title => l(:field_crm_domain), :editable => false},
                 {:field => 'status', :title => l(:field_crm_status), :editable => true},
                 {:field => 'owner', :title => l(:field_crm_owner), :editable => true}
               ]
             end %>
<div id="crm-accounts-grid"
     class="crm-grid"
     data-crm-rows="<%= h(ERB::Util.json_escape(rows.to_json)) %>"
     data-crm-update-url="<%= crm_account_path(':id') %>"
     data-crm-columns="<%= h(ERB::Util.json_escape(columns.to_json)) %>"
     data-crm-record-type="account">
  <noscript><p class="nodata"><%= l(:text_crm_enable_javascript_for_grid) %></p></noscript>
</div>
