<% lead_values = @lead.respond_to?(:to_h) ? @lead.to_h : {} %>
<% lead_value = lambda { |key| lead_values[key] || lead_values[key.to_s] } %>
<%= form_tag crm_leads_path, :method => :post, :id => 'crm-lead-form', :class => 'tabular' do %>
  <p>
    <%= label_tag 'lead_contact_first_name', l(:field_crm_first_name) %>
    <%= text_field_tag 'lead[contact_first_name]', @lead.respond_to?(:contact_first_name) ? @lead.contact_first_name : lead_value.call(:contact_first_name), :id => 'lead_contact_first_name', :required => false %>
  </p>
  <p>
    <%= label_tag 'lead_contact_last_name', l(:field_crm_last_name) %>
    <%= text_field_tag 'lead[contact_last_name]', @lead.respond_to?(:contact_last_name) ? @lead.contact_last_name : lead_value.call(:contact_last_name), :id => 'lead_contact_last_name' %>
  </p>
  <p>
    <%= label_tag 'lead_email', l(:field_crm_email) %>
    <%= email_field_tag 'lead[email]', @lead.respond_to?(:email) ? @lead.email : lead_value.call(:email), :id => 'lead_email' %>
  </p>
  <p>
    <%= label_tag 'lead_account_name', l(:field_crm_account) %>
    <%= text_field_tag 'lead[account_name]', @lead.respond_to?(:account_name) ? @lead.account_name : lead_value.call(:account_name), :id => 'lead_account_name' %>
  </p>
  <p>
    <%= label_tag 'lead_deal_name', l(:field_crm_deal_name) %>
    <%= text_field_tag 'lead[deal_name]', @lead.respond_to?(:deal_name) ? @lead.deal_name : lead_value.call(:deal_name), :id => 'lead_deal_name', :required => true %>
  </p>
  <p>
    <%= label_tag 'lead_note', l(:field_crm_first_note) %>
    <%= text_area_tag 'lead[note]', @lead.respond_to?(:note) ? @lead.note : lead_value.call(:note), :id => 'lead_note', :rows => 4 %>
  </p>
  <% if @lead.respond_to?(:errors) && @lead.errors.any? %>
    <%= error_messages_for :lead %>
  <% end %>
  <p class="buttons">
    <%= submit_tag l(:button_crm_create_lead), :name => nil %>
  </p>
<% end %>
